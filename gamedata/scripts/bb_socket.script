local function log(fmt, ...)
    if bb_debug then bb_debug.log("socket", fmt, ...) end
end

-- Module dimensions (metres). Keep in sync with tools/blender/build_greybox.py.
--
-- X-Ray is Y-up: x = right, y = up, z = forward.
-- Every greybox piece has its origin at the bottom centre:
--   foundation / roof : 2.5 (x) by 2.5 (z), 0.2 thick
--   wall / doorway    : 2.5 wide (x), 3.0 tall (y), 0.2 thick (z)
CELL   = 2.5
HALF   = CELL / 2.0
WALL_H = 3.0
SLAB_T = 0.2

-- A profile is a list of sockets. A socket is a point on the piece the player
-- aims at; each of its slots describes where a compatible held piece goes:
--
--   socket.pos    local position the crosshair is compared against
--   slot.accepts  snap classes that may use the slot
--   slot.offset   local position of the held piece's origin
--   slot.yaw      heading of the held piece relative to the target, degrees
--
-- Slots are resolved in the target piece's frame, so the held piece always
-- inherits the structure's orientation: structure geometry beats terrain.

-- Edge sockets shared by slabs (foundations and flat roofs). A slab accepts a
-- neighbouring slab of its own class one cell out, and a wall on the edge line.
local EDGES = {
    { name = "north", dx =  0, dz =  1, yaw =   0 },
    { name = "south", dx =  0, dz = -1, yaw = 180 },
    { name = "east",  dx =  1, dz =  0, yaw =  90 },
    { name = "west",  dx = -1, dz =  0, yaw = -90 },
}

local function slab_profile(own_class)
    local sockets = {}
    for _, e in ipairs(EDGES) do
        table.insert(sockets, {
            name = e.name,
            pos  = vector():set(e.dx * HALF, SLAB_T, e.dz * HALF),
            slots = {
                { accepts = { [own_class] = true }, offset = vector():set(e.dx * CELL, 0, e.dz * CELL), yaw = 0 },
                { accepts = { wall = true },        offset = vector():set(e.dx * HALF, SLAB_T, e.dz * HALF), yaw = e.yaw },
            },
        })
    end
    return sockets
end

local SOCKET_DEFINITIONS = {
    foundation_standard = slab_profile("foundation"),
    roof_flat_standard  = slab_profile("roof_flat"),

    wall_standard = {
        {
            -- Roof can sit on either side of the wall; the slot nearer the
            -- player wins the tie (see bb_snap).
            name = "top",
            pos  = vector():set(0, WALL_H, 0),
            slots = {
                { accepts = { roof_flat = true }, offset = vector():set(0, WALL_H,  HALF), yaw = 0 },
                { accepts = { roof_flat = true }, offset = vector():set(0, WALL_H, -HALF), yaw = 0 },
            },
        },
        {
            name = "left",
            pos  = vector():set(-HALF, WALL_H / 2.0, 0),
            slots = {
                { accepts = { wall = true }, offset = vector():set(-CELL, 0, 0), yaw = 0 },
            },
        },
        {
            name = "right",
            pos  = vector():set(HALF, WALL_H / 2.0, 0),
            slots = {
                { accepts = { wall = true }, offset = vector():set(CELL, 0, 0), yaw = 0 },
            },
        },
    },
}

---Gets socket templates for a profile.
---@param profile_name string
---@return table|nil
function get_profile(profile_name)
    return SOCKET_DEFINITIONS[profile_name]
end

---Expands a registered piece into world-space sockets and slots.
---@param piece table runtime piece from bb_piece.build
---@return table sockets
function generate_world_sockets(piece)
    local sockets = {}
    local profile = get_profile(piece.socket_profile)
    if not profile then return sockets end

    local heading = piece.heading

    for _, tmpl in ipairs(profile) do
        local slots = {}
        for i, slot in ipairs(tmpl.slots) do
            table.insert(slots, {
                index     = i,
                accepts   = slot.accepts,
                world_pos = vector():set(piece.position):add(bb_piece.rotate_yaw(slot.offset, heading)),
                -- Pieces are level, so headings simply add up
                heading   = bb_piece.wrap_angle(heading + math.rad(slot.yaw)),
            })
        end

        table.insert(sockets, {
            owner_id  = piece.object_id,
            name      = tmpl.name,
            world_pos = vector():set(piece.position):add(bb_piece.rotate_yaw(tmpl.pos, heading)),
            slots     = slots,
        })
    end

    return sockets
end
