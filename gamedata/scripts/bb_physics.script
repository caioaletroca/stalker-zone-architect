-- Keeps placed building pieces exactly where they were placed across
-- save/load and offline/online switches.
--
-- Why: when a physic_object goes offline or the game is saved, the engine
-- stores a snapshot of every bone's physics state on the server object
-- (CPhysicObject::net_Save -> CPHSkeleton::SaveNetState, read back by
-- CSE_PHSkeleton::load which sets flSavedData). The snapshot is quantised:
-- positions to 8 bits inside the bones' bounding range and rotations as an
-- 8-bit-per-component quaternion (SPHNetState::net_Save -> w_vec_q8 /
-- w_qt_q8). On the next spawn CPHSkeleton::RestoreNetState applies it on top
-- of the exact float position/angle, so pieces twist slightly on reload.
-- (In single player net_Export sends no physics state, so this is the only
-- path.)
--
-- Fix: bb_binder calls on_piece_net_spawn from the binder's net_spawn, which
-- the engine runs on the spawn entity right before RestoreNetState. We clear
-- flSavedData and drop the snapshot from that entity, so the physics shell
-- stays on the exact transform it was built from. Pieces have fixed bones
-- and never need their physics state restored.
--
-- Sources: xray-monolith src/xrGame/GameObject.cpp (net_Spawn),
-- src/xrGame/PhysicObject.cpp, src/xrGame/PHSkeleton.cpp,
-- src/xrServerEntities/PHNetState.cpp, xrServer_Objects.cpp.

local FL_SAVED_DATA = 4              -- CSE_PHSkeleton::flSavedData
-- SPHBonesData::net_Save: u64 bones_mask, u16 root_bone, vec3 min, vec3 max
local BONES_HEADER_SIZE = 8 + 2 + 12 + 12
-- SPHNetState::net_Save(P, min, max): 3 x q8 position, 4 x q8 quaternion, u8 enabled
local BONE_RECORD_SIZE = 3 + 4 + 1

local function log(fmt, ...)
    if bb_debug then bb_debug.log("physics", fmt, ...) end
end

---Removes the quantised physics snapshot from a physic object's STATE.
---@param se_obj cse_alife_object_physic
---@return boolean had_snapshot
local function strip_saved_physics(se_obj)
    local pk = net_packet()
    pk:w_begin(0)
    se_obj:STATE_Write(pk)
    pk:r_seek(2)

    local t = {}
    utils_stpk.parse_cse_alife_object_properties_packet(t, pk)
    utils_stpk.parse_cse_visual_properties_packet(t, pk)
    utils_stpk.parse_cse_ph_skeleton_properties_packet(t, pk)

    if bit_and(t.skeleton_flags, FL_SAVED_DATA) == 0 then return false end

    -- Skip the saved bones block that sits between the skeleton and the
    -- physic properties (utils_stpk does not parse it)
    pk:r_advance(BONES_HEADER_SIZE)
    local bones = pk:r_u16()
    pk:r_advance(bones * BONE_RECORD_SIZE)
    utils_stpk.parse_cse_alife_object_physic_properties_packet(t, pk)

    t.skeleton_flags = bit_and(t.skeleton_flags, bit_not(FL_SAVED_DATA))
    utils_stpk.set_physic_data(t, se_obj)
    return true
end

---Called by bb_binder right before the engine would restore the snapshot.
---@param obj game_object the piece coming online
---@param se_obj cse_alife_object the spawn entity the engine is using
function on_piece_net_spawn(obj, se_obj)
    if not se_obj then return end

    local ok, had_snapshot = pcall(strip_saved_physics, se_obj)
    if not ok then
        log("net_spawn obj_id=%s: failed to strip physics snapshot: %s",
            tostring(se_obj.id), tostring(had_snapshot))
        return
    end

    log("net_spawn obj_id=%s section=%s snapshot=%s",
        tostring(se_obj.id), se_obj:section_name(),
        had_snapshot and "dropped" or "none")
end
