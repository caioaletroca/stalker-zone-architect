local version = "0.2.0"

local function log(fmt, ...)
    if bb_debug then bb_debug.log("core", fmt, ...) end
end

function get_version()
    return version
end

-- HF placeable_type initialiser; runs once when HF creates the object
function init_building_piece(obj_id)
    bb_registry.register_piece(obj_id)
end

local function on_before_furniture_release(obj_id)
    bb_registry.unregister_piece(obj_id)
end

-- GAMMA's HF build picks furniture up with a bare alife_release and never
-- fires hf_on_before_furniture_release, so also listen to the engine
local function server_entity_on_unregister(se_obj)
    if se_obj then bb_registry.unregister_piece(se_obj.id) end
end

local function actor_on_first_update()
    -- HF does not re-run type initialisers on load, so rediscover pieces
    bb_registry.rebuild()
end

function on_game_start()
    log("bb_core starting (v%s)", version)

    hf_furniture_types.add_type("building_piece", init_building_piece, true)

    RegisterScriptCallback("hf_on_before_furniture_release", on_before_furniture_release)
    RegisterScriptCallback("server_entity_on_unregister", server_entity_on_unregister)
    RegisterScriptCallback("actor_on_first_update", actor_on_first_update)

    bb_hf_compat.install()
end
