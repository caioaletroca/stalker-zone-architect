local function log(fmt, ...)
    if bb_debug then bb_debug.log("snap", fmt, ...) end
end

SNAP_RADIUS = 1.0
SEARCH_RADIUS = 12.0

function get_snap_radius()
    return SNAP_RADIUS
end

function set_snap_radius(radius)
    SNAP_RADIUS = radius or 1.0
end

---Collects sockets from registered pieces near a position.
---@param position vector
---@param radius number|nil
---@return table sockets
function collect_nearby_sockets(position, radius)
    radius = radius or SEARCH_RADIUS
    local found = {}

    for obj_id, piece in pairs(bb_registry.get_all_pieces()) do
        if position:distance_to(piece.position) <= radius then
            for _, socket in ipairs(bb_socket.generate_world_sockets(piece)) do
                table.insert(found, socket)
            end
        end
    end

    return found
end

---Finds the nearest compatible socket pair for a held piece.
---@param candidate_pos vector Candidate placement position from HF
---@param held_piece table Runtime piece definition of the held item
---@return table|nil match {target_socket, held_socket, distance}
local function get_crosshair_object_id()
    local obj = level.get_target_obj()
    if not obj then return nil end
    return obj:id()
end

function find_best_snap(candidate_pos, held_piece)
    if not (candidate_pos and held_piece) then return nil end

    local crosshair_object_id = get_crosshair_object_id()
    local best = nil

    for _, target in ipairs(collect_nearby_sockets(candidate_pos)) do
        local requires_crosshair_target = target.type == "wall_left"
            or target.type == "wall_right"
            or target.type == "foundation_edge"
        local is_crosshair_target = crosshair_object_id == target.owner_id

        if not target.occupied and (not requires_crosshair_target or is_crosshair_target) then
            local target_rotation = aol_rotation.Quaternion(target.orientation)
            local held_sockets = bb_socket.generate_world_sockets({
                object_id      = -1,
                position       = candidate_pos,
                rotation       = target_rotation,
                socket_profile = held_piece.socket_profile,
            })

            for _, held in ipairs(held_sockets) do
                if bb_socket.is_compatible(target, held) then
                    local requires_crosshair_target = target.type == "wall_left"
                        or target.type == "wall_right"
                        or target.type == "foundation_edge"
                    local dist = requires_crosshair_target
                        and candidate_pos:distance_to(target.world_pos)
                        or target.world_pos:distance_to(held.world_pos)

                    if dist <= SNAP_RADIUS and (not best or dist < best.distance) then
                        best = {
                            target_socket = target,
                            held_socket = held,
                            rotation = target_rotation,
                            distance = dist,
                        }
                    end
                end
            end
        end
    end

    if best then
        log("Snap candidate: target=%s held=%s dist=%.3f",
            best.target_socket.name, best.held_socket.name, best.distance)
    end

    return best
end

---Derives the snapped world position for a matched socket pair.
---Rotation handling is deliberately deferred until the compat layer exists,
---so orientation can be validated against live HF preview data.
---@param candidate_pos vector
---@param match table
---@return vector snapped_position
function calculate_snapped_position(candidate_pos, match)
    if not match then return candidate_pos end

    local delta = vector():set(match.target_socket.world_pos):sub(match.held_socket.world_pos)
    return vector():set(candidate_pos):add(delta)
end

function get_definition(section)
    return bb_piece.get_definition(section)
end

function apply_candidate(section, candidate_pos, candidate_rotation)
    local definition = get_definition(section)
    if not definition then return candidate_pos, candidate_rotation, nil end

    local match = find_best_snap(candidate_pos, definition)
    if not match then return candidate_pos, candidate_rotation, nil end

    local snapped_pos = calculate_snapped_position(candidate_pos, match)
    log("Snap accepted: section=%s owner=%s socket=%s distance=%.3f",
        section,
        tostring(match.target_socket.owner_id),
        match.target_socket.name,
        match.distance)

    return snapped_pos, match.rotation, match
end
