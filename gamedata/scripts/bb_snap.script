local function log(fmt, ...)
    if bb_debug then bb_debug.log("snap", fmt, ...) end
end

-- Max distance between the crosshair point and a socket for a snap
SNAP_RADIUS = 1.5
-- Only pieces whose origin is this close to the crosshair are considered
SEARCH_RADIUS = 8.0
-- A slot counts as taken when a piece of the same snap class sits this close
OCCUPIED_EPSILON = 0.15
-- Building pieces skip HF's ray collision test: snapped pieces go where the
-- structure says, and level foundations are meant to cut into slopes, so
-- neighbours/terrain would otherwise block most placements
IGNORE_COLLISION = true

function get_snap_radius()
    return SNAP_RADIUS
end

function set_snap_radius(radius)
    SNAP_RADIUS = radius or 1.5
end

local function current_level_id()
    return alife():level_id()
end

---Pieces on the current level close to a position.
---@param position vector
---@return table pieces
function collect_nearby_pieces(position)
    local found = {}
    local level_id = current_level_id()

    for obj_id, piece in pairs(bb_registry.get_all_pieces()) do
        if piece.level_id == level_id and position:distance_to(piece.position) <= SEARCH_RADIUS then
            -- Drop pieces whose object was released without a callback
            local se_obj = alife_object(obj_id)
            if se_obj and se_obj:section_name() == piece.section then
                table.insert(found, piece)
            else
                bb_registry.unregister_piece(obj_id)
            end
        end
    end

    return found
end

---True when a registered piece of `snap_class` already occupies `world_pos`.
---@param world_pos vector
---@param snap_class string
---@param pieces table nearby pieces
---@return boolean
function is_slot_occupied(world_pos, snap_class, pieces)
    for _, piece in ipairs(pieces) do
        if piece.snap_class == snap_class and piece.position:distance_to(world_pos) <= OCCUPIED_EPSILON then
            return true
        end
    end
    return false
end

---Finds the best free slot for a held piece near the crosshair.
---Score is the crosshair-to-socket distance; ties (e.g. a roof on either side
---of a wall) go to the slot nearer the player.
---@param candidate_pos vector HF's candidate placement position
---@param definition table held piece definition (bb_piece.get_definition)
---@return table|nil match {piece, socket, slot, distance}
function find_best_snap(candidate_pos, definition)
    if not (candidate_pos and definition) then return nil end

    local actor_pos = db.actor and db.actor:position() or candidate_pos
    local pieces = collect_nearby_pieces(candidate_pos)
    local best = nil

    for _, piece in ipairs(pieces) do
        for _, socket in ipairs(bb_socket.generate_world_sockets(piece)) do
            local dist = candidate_pos:distance_to(socket.world_pos)
            if dist <= SNAP_RADIUS then
                for _, slot in ipairs(socket.slots) do
                    if slot.accepts[definition.snap_class]
                        and not is_slot_occupied(slot.world_pos, definition.snap_class, pieces) then
                        local score = dist + 0.001 * actor_pos:distance_to(slot.world_pos)
                        if not best or score < best.score then
                            best = {
                                piece    = piece,
                                socket   = socket,
                                slot     = slot,
                                distance = dist,
                                score    = score,
                            }
                        end
                    end
                end
            end
        end
    end

    return best
end

local last_logged_key = nil

---HF candidate rotation (aol_rotation quaternion) -> level heading, using
---the same conversion HF uses when it creates the object (to_euler_angles).
---@param candidate_rotation aol_rotation.Quaternion|nil
---@return number heading radians
local function candidate_heading(candidate_rotation)
    if not (candidate_rotation and candidate_rotation.to_euler_angles) then return 0 end
    return bb_piece.heading_from_angle(candidate_rotation:to_euler_angles())
end

---Applies structural snapping to an HF candidate transform.
---Every building piece comes out level: snapped pieces take the slot's
---position and heading, free-placed ones keep HF's position and heading.
---@param section string physic object section being placed
---@param candidate_pos vector
---@param candidate_rotation aol_rotation.Quaternion
---@return vector position, number heading, table|nil match
function apply_candidate(section, candidate_pos, candidate_rotation)
    local definition = bb_piece.get_definition(section)
    if not definition then return candidate_pos, candidate_heading(candidate_rotation), nil end

    local match = find_best_snap(candidate_pos, definition)

    -- Log only when the snap target changes; this runs every frame in preview
    local key = match and (match.piece.object_id .. ":" .. match.socket.name .. ":" .. match.slot.index) or "none"
    if key ~= last_logged_key then
        last_logged_key = key
        if match then
            log("snap %s -> obj=%s (%s) socket=%s slot=%s dist=%.2f structure=%s heading_deg=%.2f",
                section, tostring(match.piece.object_id), match.piece.section,
                match.socket.name, tostring(match.slot.index), match.distance,
                tostring(match.piece.structure_id), math.deg(match.slot.heading))
        else
            log("no snap for %s at (%.2f, %.2f, %.2f)", section, candidate_pos.x, candidate_pos.y, candidate_pos.z)
        end
    end

    if not match then
        return candidate_pos, candidate_heading(candidate_rotation), nil
    end
    return vector():set(match.slot.world_pos), match.slot.heading, match
end
