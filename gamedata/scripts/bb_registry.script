local pieces_by_id = {}
local structure_ids = {}

local MAX_OBJECT_ID = 65534

local function log(fmt, ...)
    if bb_debug then bb_debug.log("registry", fmt, ...) end
end

local function make_structure_id(obj_id)
    return "bb_" .. tostring(obj_id)
end

local function remove_from_structure(piece)
    local structure = structure_ids[piece.structure_id]
    if not structure then return end
    structure[piece.object_id] = nil
    if not next(structure) then
        structure_ids[piece.structure_id] = nil
    end
end

---Registers (or refreshes) a structural piece. A piece without a saved
---structure_id starts a new structure rooted at itself.
---@param obj_id number
---@return table|nil
function register_piece(obj_id)
    local se_obj = alife_object(obj_id)
    if not (se_obj and bb_piece.get_definition(se_obj:section_name())) then return nil end

    -- Fill in missing persistent fields. Right after HF creates the object its
    -- server transform is exactly the (snapped) placement transform, so that
    -- is what gets saved; physics can't nudge it afterwards.
    local bb_data = bb_piece.get_data(obj_id) or {}
    local dirty = false
    if not bb_data.structure_id then
        bb_data.structure_id = make_structure_id(obj_id)
        dirty = true
    end
    if not bb_data.px then
        bb_piece.with_transform(bb_data, se_obj.position, se_obj.angle)
        dirty = true
    end
    if dirty then bb_piece.set_data(obj_id, bb_data) end

    local piece = bb_piece.build(obj_id)
    if not piece then return nil end

    local previous = pieces_by_id[obj_id]
    if previous then remove_from_structure(previous) end

    pieces_by_id[obj_id] = piece
    structure_ids[piece.structure_id] = structure_ids[piece.structure_id] or {}
    structure_ids[piece.structure_id][obj_id] = piece
    log("Registered obj_id=%s section=%s structure=%s pos=(%.3f, %.3f, %.3f) angle_deg=(%.2f, %.2f, %.2f) live=(%.3f, %.3f, %.3f) live_angle_deg=(%.2f, %.2f, %.2f)",
        tostring(obj_id), piece.section, piece.structure_id,
        piece.position.x, piece.position.y, piece.position.z,
        math.deg(piece.angle.x), math.deg(piece.angle.y), math.deg(piece.angle.z),
        se_obj.position.x, se_obj.position.y, se_obj.position.z,
        math.deg(se_obj.angle.x), math.deg(se_obj.angle.y), math.deg(se_obj.angle.z))
    return piece
end

---@param obj_id number
function unregister_piece(obj_id)
    local piece = pieces_by_id[obj_id]
    if not piece then return end

    remove_from_structure(piece)
    pieces_by_id[obj_id] = nil
    log("Unregistered obj_id=%s", tostring(obj_id))
end

---@param obj_id number
---@return table|nil
function get_piece(obj_id)
    return pieces_by_id[obj_id]
end

---@return table
function get_all_pieces()
    return pieces_by_id
end

---@param structure_id string
---@return table|nil
function get_structure_pieces(structure_id)
    return structure_ids[structure_id]
end

---@return number
function count()
    local total = 0
    for _ in pairs(pieces_by_id) do total = total + 1 end
    return total
end

---Reconstructs the registry from server objects after a load.
---HF only runs placeable_type initialisers when an object is first created,
---so pieces from a save must be rediscovered here. bb data itself lives in
---HF's per-object storage (hf_obj_manager), which survives save/load.
function rebuild()
    pieces_by_id = {}
    structure_ids = {}

    local sim = alife()
    for id = 1, MAX_OBJECT_ID do
        local se_obj = sim:object(id)
        if se_obj and bb_piece.get_definition(se_obj:section_name()) then
            register_piece(id)
        end
    end

    log("Rebuilt registry, pieces=%s", tostring(count()))
end
