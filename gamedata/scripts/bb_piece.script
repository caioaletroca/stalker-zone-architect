local function log(fmt, ...)
    if bb_debug then bb_debug.log("piece", fmt, ...) end
end

-- Piece type constants
PIECE_TYPES = {
    FOUNDATION  = "foundation",
    FLOOR       = "floor",
    WALL        = "wall",
    WALL_DOOR   = "wall_door",
    WALL_WINDOW = "wall_window",
    ROOF_FLAT   = "roof_flat",
}

---Reads the bb_* config block for a section.
---@param section string
---@return table|nil definition
function get_definition(section)
    if not section then return nil end

    local piece_type = ini_sys:r_string_ex(section, "bb_piece_type")
    if not piece_type then return nil end

    local size_str = ini_sys:r_string_ex(section, "bb_piece_size") or "1,1,1"
    local size_parts = str_explode(size_str, ",")

    return {
        section        = section,
        piece_type     = piece_type,
        socket_profile = ini_sys:r_string_ex(section, "bb_socket_profile") or piece_type,
        size = vector():set(
            tonumber(size_parts[1]) or 1,
            tonumber(size_parts[2]) or 1,
            tonumber(size_parts[3]) or 1
        ),
    }
end

---@param obj_id number
---@return boolean
function is_building_piece(obj_id)
    local obj = alife_object(obj_id)
    if not obj then return false end
    return get_definition(obj:section_name()) ~= nil
end

---Reads persisted bb metadata for an object.
---@param obj_id number
---@return table|nil
function get_data(obj_id)
    local hf_data = hf_obj_manager.get_data(obj_id)
    if not hf_data then return nil end
    return hf_data.bb
end

---Writes bb metadata for an object. Replaces the whole bb subtable,
---since hf_obj_manager.update_data only performs a shallow merge.
---@param obj_id number
---@param bb_data table
function set_data(obj_id, bb_data)
    hf_obj_manager.update_data(obj_id, { bb = bb_data })
    log("Saved bb data for obj_id=%s", tostring(obj_id))
end

---Builds the runtime piece record from a live/server object.
---@param obj_id number
---@return table|nil
function build(obj_id)
    local obj = alife_object(obj_id)
    if not obj then return nil end

    local definition = get_definition(obj:section_name())
    if not definition then return nil end

    local bb_data = get_data(obj_id) or {}

    return {
        object_id      = obj_id,
        section        = obj:section_name(),
        piece_type     = definition.piece_type,
        socket_profile = definition.socket_profile,
        size           = definition.size,
        position       = vector():set(obj.position),
        angle          = vector():set(obj.angle),
        structure_id   = bb_data.structure_id,
        gx             = bb_data.gx,
        gy             = bb_data.gy,
        gz             = bb_data.gz,
        orientation    = bb_data.orientation,
    }
end
