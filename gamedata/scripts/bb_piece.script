local function log(fmt, ...)
    if bb_debug then bb_debug.log("piece", fmt, ...) end
end

-- Piece type constants
PIECE_TYPES = {
    FOUNDATION  = "foundation",
    FLOOR       = "floor",
    WALL        = "wall",
    WALL_DOOR   = "wall_door",
    WALL_WINDOW = "wall_window",
    ROOF_FLAT   = "roof_flat",
}

-- section -> definition (false when the section is not a building piece)
local definition_cache = {}

---Reads the bb_* config block for a section. Cached per section.
---@param section string
---@return table|nil definition
function get_definition(section)
    if not section then return nil end

    local cached = definition_cache[section]
    if cached ~= nil then return cached or nil end

    local piece_type = ini_sys:r_string_ex(section, "bb_piece_type")
    if not piece_type then
        definition_cache[section] = false
        return nil
    end

    local size_str = ini_sys:r_string_ex(section, "bb_piece_size") or "1,1,1"
    local size_parts = str_explode(size_str, ",")

    local definition = {
        section        = section,
        piece_type     = piece_type,
        -- Pieces sharing a snap class are interchangeable for snapping and
        -- occupancy (e.g. wall and wall_door both use "wall")
        snap_class     = ini_sys:r_string_ex(section, "bb_snap_class") or piece_type,
        socket_profile = ini_sys:r_string_ex(section, "bb_socket_profile") or piece_type,
        size = vector():set(
            tonumber(size_parts[1]) or 1,
            tonumber(size_parts[2]) or 1,
            tonumber(size_parts[3]) or 1
        ),
    }
    definition_cache[section] = definition
    return definition
end

---@param obj_id number
---@return boolean
function is_building_piece(obj_id)
    local obj = alife_object(obj_id)
    if not obj then return false end
    return get_definition(obj:section_name()) ~= nil
end

---Reads persisted bb metadata for an object.
---@param obj_id number
---@return table|nil
function get_data(obj_id)
    local hf_data = hf_obj_manager.get_data(obj_id)
    if not hf_data then return nil end
    return hf_data.bb
end

---Writes bb metadata for an object. Replaces the whole bb subtable,
---since hf_obj_manager.update_data only performs a shallow merge.
---@param obj_id number
---@param bb_data table
function set_data(obj_id, bb_data)
    hf_obj_manager.update_data(obj_id, { bb = bb_data })
    log("Saved bb data for obj_id=%s structure=%s", tostring(obj_id), tostring(bb_data.structure_id))
end

local UP = vector():set(0, 1, 0)
local FORWARD = vector():set(0, 0, 1)

---Keeps only the heading of a rotation, so the piece stands level.
---Structures never tilt with terrain: a yaw-only rotation saves as euler
---(0, h, 0), which the engine and aol_rotation interpret identically,
---while pitch/bank round trips are not guaranteed to match the engine.
---Ported and checked in tools/sim_snap.py (upright).
---@param q aol_rotation.Quaternion|nil
---@return aol_rotation.Quaternion
function upright_rotation(q)
    if not q then return aol_rotation.Quaternion() end

    local fwd = q:rotate_vector(FORWARD)
    fwd.y = 0
    if fwd:magnitude() < 0.0001 then return aol_rotation.Quaternion() end
    fwd:normalize()

    local heading = math.atan2(fwd.x, fwd.z)
    local q_up = aol_rotation.get_rotation_around(UP, heading)
    if q_up:rotate_vector(FORWARD):dotproduct(fwd) < 0.999 then
        q_up = aol_rotation.get_rotation_around(UP, -heading)
    end
    return q_up
end

---Adds the placement transform to a bb data table as plain numbers
---(HF storage serialises primitives reliably, vectors not necessarily).
---@param bb_data table
---@param position vector
---@param angle vector euler angles as stored on the server object
---@return table bb_data
function with_transform(bb_data, position, angle)
    bb_data.px, bb_data.py, bb_data.pz = position.x, position.y, position.z
    bb_data.ax, bb_data.ay, bb_data.az = angle.x, angle.y, angle.z
    return bb_data
end

---Level id of a server object, used to keep structures on different maps apart.
---@param se_obj cse_alife_object
---@return number|nil
function get_level_id(se_obj)
    local gvid = se_obj and se_obj.m_game_vertex_id
    if not gvid then return nil end
    return game_graph():vertex(gvid):level_id()
end

---Builds the runtime piece record from a server object.
---@param obj_id number
---@return table|nil
function build(obj_id)
    local obj = alife_object(obj_id)
    if not obj then return nil end

    local definition = get_definition(obj:section_name())
    if not definition then return nil end

    local bb_data = get_data(obj_id) or {}

    -- Prefer the transform saved at placement time: it is exactly on the
    -- structure grid, while the live object may have been nudged by physics
    local position, angle
    if bb_data.px then
        position = vector():set(bb_data.px, bb_data.py, bb_data.pz)
        angle = vector():set(bb_data.ax, bb_data.ay, bb_data.az)
    else
        position = vector():set(obj.position)
        angle = vector():set(obj.angle)
    end

    return {
        object_id      = obj_id,
        section        = obj:section_name(),
        piece_type     = definition.piece_type,
        snap_class     = definition.snap_class,
        socket_profile = definition.socket_profile,
        size           = definition.size,
        position       = position,
        angle          = angle,
        -- Level even for pieces saved tilted by older versions
        rotation       = upright_rotation(aol_rotation.Quaternion(angle)),
        level_id       = get_level_id(obj),
        structure_id   = bb_data.structure_id,
        attached_to    = bb_data.attached_to,
    }
end
