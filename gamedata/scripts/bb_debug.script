local enabled = true

function is_enabled()
    return enabled
end

function set_enabled(value)
    enabled = value == true
end

function log(scope, fmt, ...)
    if not enabled then return end
    printf("base_building[" .. tostring(scope) .. "]: " .. string.format(fmt, ...))
end

function dump_registry()
    log("debug", "registered structural pieces=%s", tostring(bb_registry.count()))
    for obj_id, piece in pairs(bb_registry.get_all_pieces()) do
        log("debug", "obj_id=%s section=%s type=%s structure=%s", tostring(obj_id), piece.section, piece.piece_type, tostring(piece.structure_id))
    end
end
