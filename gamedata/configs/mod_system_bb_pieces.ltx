visual                                  = dynamics\Decor\wall02.ogf
placeable_type                          = building_piece
base_rotation                           = 0

script_binding                          = bind_hf_base.init
item_section                            = bb_item_wall

; Keep structural sockets on the 2.5m grid, but inset the HF collision box
; so adjacent walls leave 6cm clearance and do not ray-collide at a boundary.
bounding_box_size                       = 2.44, 0.16, 2.44
bounding_box_origin                     = 0.0, 1.25, 0.0

; bb_piece_size is X-Ray local extents: x (width), y (up/height), z (depth)
bb_piece_type                           = wall
bb_piece_size                           = 2.5, 2.5, 0.2
bb_socket_profile                       = wall_standard

